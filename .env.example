# Copy this file to `.env` and fill in your Angel One SmartAPI details.
# API key: https://smartapi.angelbroking.com/ -> My Apps -> create an app of type "Trading APIs"
# (the app name can be anything; only the API key is used)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# 4-digit login PIN (MPIN)
ANGEL_PIN=
# Base32 secret shown when enabling TOTP at https://smartapi.angelbroking.com/enable-totp
ANGEL_TOTP_SECRET=
# Telegram alerts (optional): bot token from @BotFather; chat id from
#   .venv/bin/python -m market_agent.telegram --find-chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
