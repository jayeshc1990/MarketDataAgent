# Copy this file to `.env` and fill in your Angel One SmartAPI details.
# API key: https://smartapi.angelbroking.com/ -> My Apps -> create "Market Feeds API" app
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# 4-digit login PIN (MPIN)
ANGEL_PIN=
# Base32 secret shown when enabling TOTP at https://smartapi.angelbroking.com/enable-totp
ANGEL_TOTP_SECRET=
